# Maintainer: Michael Jones <mikej.ebay@gmail.com>
pkgname=pippin-git
_pkgname=pippin
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux client for macOS high-performance Screen Sharing (latest commit)"
arch=('x86_64' 'aarch64')
url="https://github.com/jonesy827/pippin"
license=('AGPL-3.0-or-later')
depends=('ffmpeg' 'alsa-lib' 'libxkbcommon' 'gcc-libs' 'glibc')
makedepends=('cargo' 'clang' 'git')
optdepends=(
  'libfdk-aac: audio'
  'vulkan-driver: GPU rendering (falls back to OpenGL)'
  'org.freedesktop.secrets: saving passwords to the keyring'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  if git describe --tags >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/pippin -t "$pkgdir/usr/bin"
  install -Dm644 assets/pippin.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 assets/pippin.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$_pkgname"
}
